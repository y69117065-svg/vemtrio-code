   "re": {
    "src": "\\b(coinhive|coin-hive|cryptonight|xmrig|stratum\\+tcp|coinimp|deepminer|webminepool|cryptoloot|minero\\.cc|jsecoin)\\b",
    "flags": "i"
   },
   "tr": "Kripto para madencisi izi (bilgisayarını gizlice yorar).",
   "en": "Crypto-miner signature (secretly uses your CPU)."
  },
  {
